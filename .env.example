# Environment variables for Raymond Gray Vehicle Services
# Copy this file to .env.local for local development.

# Base URL of the main Raymond Gray platform. The booking proxy
# (src/app/api/booking/route.ts) forwards submissions server-side to
# ${NEXT_PUBLIC_API_URL}/api/vehicle-bookings.
#
# Used ONLY on the server (the browser posts same-origin to /api/booking), so it
# carries no secret and needs no CORS. No WEBHOOK_SECRET is required for this
# endpoint — the platform protects it with CORS + per-IP rate limiting + honeypot.
#
#   Production : https://www.raymond-gray.org   (note: with "www")
#   Local      : http://localhost:3000          (a locally-running platform)
#
# In Vercel, set NEXT_PUBLIC_API_URL on the project to the production value.
NEXT_PUBLIC_API_URL=https://www.raymond-gray.org
